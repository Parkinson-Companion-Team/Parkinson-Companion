<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5F0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="36dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- Header -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="70dp"
                android:layout_height="48dp"
                android:backgroundTint="#315C55"
                android:contentDescription="Go back to main screen"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="4dp"
                android:text="←"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:visibility="visible" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Features of the App"
                android:textColor="#315C55"
                android:textSize="23sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="Discover the features designed to support your daily life."
            android:textColor="#606B66"
            android:textSize="15sp" />

        <!-- Feature cards grid matching design note -->

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:useDefaultMargins="true">

            <!-- Row 1: Diet & Calorie Tracker | Exercise -->
            <TextView
                android:id="@+id/cardDiet"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_columnWeight="1"
                android:background="#F5E9D5"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="8dp"
                android:text="🥗\nDiet &amp; Calorie Tracker"
                android:textColor="#6C4C27"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/cardExercise"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_columnWeight="1"
                android:background="#E6E7F5"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="8dp"
                android:text="🏃\nExercise"
                android:textColor="#35385D"
                android:textSize="17sp" />

            <!-- Row 2: Medicine Reminder | Appointment Reminder -->
            <TextView
                android:id="@+id/cardMedicine"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_columnWeight="1"
                android:background="#DDECE5"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="8dp"
                android:text="💊\nMedicine Reminder"
                android:textColor="#244C43"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/cardAppointment"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_columnWeight="1"
                android:background="#DCEAF5"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="8dp"
                android:text="📅\nAppointment Reminder"
                android:textColor="#284B68"
                android:textSize="15sp" />

            <!-- Row 3: To-Do | Handwriting Test -->
            <TextView
                android:id="@+id/cardToDo"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_columnWeight="1"
                android:background="#F5E1E3"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="8dp"
                android:text="✅\nTo-Do"
                android:textColor="#70404A"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/cardHandwriting"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_columnWeight="1"
                android:background="#F5E1E3"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="8dp"
                android:text="✍️\nHandwriting Test"
                android:textColor="#70404A"
                android:textSize="16sp" />

            <!-- Row 4: Voice Test | Tremor Test -->
            <TextView
                android:id="@+id/cardVoice"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_columnWeight="1"
                android:background="#DDECE5"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="8dp"
                android:text="🎙️\nVoice Test"
                android:textColor="#244C43"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/cardTremor"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_columnWeight="1"
                android:background="#F5E9D5"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="8dp"
                android:text="🤲\nTremor Test"
                android:textColor="#6C4C27"
                android:textSize="17sp" />

            <!-- Row 5: Progress Tracking | AI Assistant -->
            <TextView
                android:id="@+id/cardProgress"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_columnWeight="1"
                android:background="#DCEAF5"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="8dp"
                android:text="📈\nProgress Tracking"
                android:textColor="#284B68"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/cardAiAssistant"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_columnWeight="1"
                android:background="#EDE1F3"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="8dp"
                android:text="🤖\nAI Assistant"
                android:textColor="#59416B"
                android:textSize="17sp" />

        </GridLayout>

    </LinearLayout>

</ScrollView>