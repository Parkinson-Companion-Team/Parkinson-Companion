<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5F0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="70dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="4dp"
                android:text="←"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#315C55"
                android:contentDescription="Go back" />

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Add Appointment"
                android:textColor="#315C55"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Appointment Title + Mic -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Appointment Title *"
            android:textColor="#244C43"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etTitle"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/edit_text_border"
                android:hint="e.g. Therapy / Consultation"
                android:inputType="textCapWords"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#244C43"
                android:textColorHint="#8A9691"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btnTitleMic"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/edit_text_border"
                android:backgroundTint="#DDECE5"
                android:contentDescription="Voice title input"
                android:src="@drawable/ic_mic" />

        </LinearLayout>

        <!-- Doctor Name + Mic -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Doctor / Specialist Name"
            android:textColor="#244C43"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etDoctor"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/edit_text_border"
                android:hint="e.g. Sunil Geura"
                android:inputType="textPersonName"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#244C43"
                android:textColorHint="#8A9691"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btnDoctorMic"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/edit_text_border"
                android:backgroundTint="#DDECE5"
                android:contentDescription="Voice doctor name input"
                android:src="@drawable/ic_mic" />

        </LinearLayout>

        <!-- Location + Mic + Map Button -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Clinic / Hospital Location"
            android:textColor="#244C43"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etLocation"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/edit_text_border"
                android:hint="e.g. Barasat Govt Hospital"
                android:inputType="textCapWords"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#244C43"
                android:textColorHint="#8A9691"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btnLocationMic"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/edit_text_border"
                android:backgroundTint="#DDECE5"
                android:contentDescription="Voice location input"
                android:src="@drawable/ic_mic" />

        </LinearLayout>

        <Button
            android:id="@+id/btnOpenMap"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#DCEAF5"
            android:text="📍 View / Search Location in Google Maps"
            android:textAllCaps="false"
            android:textColor="#284B68"
            android:textSize="14sp" />

        <!-- Hospital Phone Number -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Hospital / Clinic Phone Number"
            android:textColor="#244C43"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edit_text_border"
            android:hint="e.g. +91 98765 43210"
            android:inputType="phone"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#244C43"
            android:textColorHint="#8A9691"
            android:textSize="15sp" />

        <!-- Date & Time Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Date *"
                    android:textColor="#244C43"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etDate"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/edit_text_border"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="Select Date"
                    android:inputType="none"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#244C43"
                    android:textColorHint="#8A9691"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Time *"
                    android:textColor="#244C43"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etTime"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/edit_text_border"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="Select Time"
                    android:inputType="none"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#244C43"
                    android:textColorHint="#8A9691"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Reminder Offset -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Remind Me"
            android:textColor="#244C43"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerOffset"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edit_text_border"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

        <!-- Notes with Voice Mic Button -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Notes / Prescription Instructions"
            android:textColor="#244C43"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="top"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etNotes"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:background="@drawable/edit_text_border"
                android:gravity="top"
                android:hint="Add notes or dictate via voice mic..."
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:textColor="#244C43"
                android:textColorHint="#8A9691"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnNotesMic"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/edit_text_border"
                android:backgroundTint="#DDECE5"
                android:contentDescription="Voice note dictation"
                android:src="@drawable/ic_mic" />

        </LinearLayout>

        <!-- Prescription Image Upload -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Prescription Image"
            android:textColor="#244C43"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnUploadPrescription"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#E6E7F5"
            android:text="📄 Upload Prescription Photo"
            android:textAllCaps="false"
            android:textColor="#35385D"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/ivPrescriptionPreview"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/edit_text_border"
            android:contentDescription="Prescription Image Preview"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- Online Booking Portals -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Book Appointment Online"
            android:textColor="#244C43"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBookORS"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#F5E9D5"
                android:text="🏥 ORS (Govt)"
                android:textAllCaps="false"
                android:textColor="#6C4C27"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnBookPracto"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#EDE1F3"
                android:text="🩺 Practo (Private)"
                android:textAllCaps="false"
                android:textColor="#59416B"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveAppointment"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#477D70"
            android:text="Save &amp; Set Alarm ⏰"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

    </LinearLayout>

</ScrollView>