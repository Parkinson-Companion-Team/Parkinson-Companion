<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Top Toolbar Header -->
    <LinearLayout
        android:id="@+id/layoutTopHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentTop="true"
        android:background="#673AB7"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/btnMedicineListBack"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:backgroundTint="#512DA8"
            android:contentDescription="Back"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="4dp"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Medicine Reminder"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <View
            android:layout_width="56dp"
            android:layout_height="48dp" />

    </LinearLayout>

    <!-- Empty State Container -->
    <LinearLayout
        android:id="@+id/layoutEmptyMedicineState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💊"
            android:textSize="64sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="No Medicine Reminders Set"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Tap the + button below to add your daily pill schedule with voice or text."
            android:textColor="#475569"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- RecyclerView for Medicine List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewMedicines"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutTopHeader"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="88dp" />

    <!-- Floating Action Button for Adding New Medicine -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddMedicine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="Add New Medicine"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="#00BCD4"
        app:fabCustomSize="64dp"
        app:maxImageSize="36dp"
        app:tint="#000000" />

</RelativeLayout>
