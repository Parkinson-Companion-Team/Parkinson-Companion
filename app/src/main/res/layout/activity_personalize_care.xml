<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5F0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="70dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="4dp"
                android:text="←"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#315C55"
                android:contentDescription="Go back to features dashboard" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Let's personalize your care"
                android:textColor="#315C55"
                android:textSize="21sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 1. What is your Name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="1. What is your Name"
            android:textColor="#244C43"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etName"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/edit_text_border"
                android:hint="Enter your name"
                android:inputType="textPersonName"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#244C43"
                android:textColorHint="#8A9691"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btnMic"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/edit_text_border"
                android:backgroundTint="#DDECE5"
                android:contentDescription="Microphone option"
                android:src="@drawable/ic_mic" />

        </LinearLayout>

        <!-- 2. Date of birth -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="2. Date of birth"
            android:textColor="#244C43"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDob"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edit_text_border"
            android:clickable="true"
            android:focusable="false"
            android:hint="Select date of birth"
            android:inputType="none"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#244C43"
            android:textColorHint="#8A9691"
            android:textSize="15sp" />

        <!-- 3. Gender -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="3. Gender"
            android:textColor="#244C43"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerGender"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edit_text_border"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <!-- 4. Choose accessibility features -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="4. Choose accessibility features"
            android:textColor="#244C43"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="(Large Text, High contrast, Voice Navigation, Bigger Buttons, Haptic Feedback)"
            android:textColor="#606B66"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spinnerAccessibility"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edit_text_border"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <!-- 5. Unified Parkinson's Disease Rating scale Section Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="5. Unified Parkinson's Disease Rating Scale (UPDRS III)"
            android:textColor="#244C43"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:text="Select the score (0 to 4) for each question below:"
            android:textColor="#606B66"
            android:textSize="14sp" />

        <!-- UPDRS Questions List -->

        <!-- 18. Speech -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/edit_text_border"
            android:backgroundTint="#F0F5F2"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="18. Speech"
                android:textColor="#315C55"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgQ18"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/rbQ18_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="0 = Normal"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ18_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1 = Slight loss of expression/volume"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ18_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2 = Monotone, slurred but understandable"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ18_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3 = Marked impairment, difficult to understand"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ18_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4 = Unintelligible"
                    android:textColor="#333333" />
            </RadioGroup>
        </LinearLayout>

        <!-- 19. Facial Expression -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/edit_text_border"
            android:backgroundTint="#F0F5F2"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="19. Facial Expression"
                android:textColor="#315C55"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgQ19"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/rbQ19_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="0 = Normal"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ19_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1 = Minimal hypomimia (Poker Face)"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ19_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2 = Slight abnormal facial expression"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ19_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3 = Moderate hypomimia; lips parted"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ19_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4 = Masked or fixed facies"
                    android:textColor="#333333" />
            </RadioGroup>
        </LinearLayout>

        <!-- 20. Tremor at rest -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/edit_text_border"
            android:backgroundTint="#F0F5F2"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="20. Tremor at Rest (Face, Hands, Feet)"
                android:textColor="#315C55"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgQ20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/rbQ20_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="0 = Absent"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ20_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1 = Slight and infrequently present"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ20_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2 = Mild in amplitude / persistent"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ20_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3 = Moderate in amplitude most of time"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ20_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4 = Marked in amplitude most of time"
                    android:textColor="#333333" />
            </RadioGroup>
        </LinearLayout>

        <!-- 21. Action or Postural Tremor -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/edit_text_border"
            android:backgroundTint="#F0F5F2"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="21. Action or Postural Tremor of Hands"
                android:textColor="#315C55"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgQ21"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/rbQ21_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="0 = Absent"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ21_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1 = Slight, present with action"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ21_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2 = Moderate in amplitude with action"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ21_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3 = Moderate with posture and action"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ21_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4 = Marked; interferes with feeding"
                    android:textColor="#333333" />
            </RadioGroup>
        </LinearLayout>

        <!-- 22. Rigidity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/edit_text_border"
            android:backgroundTint="#F0F5F2"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="22. Rigidity (Neck &amp; Limbs)"
                android:textColor="#315C55"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgQ22"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/rbQ22_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="0 = Absent"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ22_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1 = Slight or with activation"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ22_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2 = Mild to moderate"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ22_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3 = Marked, easily moved"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ22_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4 = Severe rigidity"
                    android:textColor="#333333" />
            </RadioGroup>
        </LinearLayout>

        <!-- 23. Finger Taps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/edit_text_border"
            android:backgroundTint="#F0F5F2"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="23. Finger Taps (Thumb and Index Finger)"
                android:textColor="#315C55"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgQ23"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/rbQ23_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="0 = Normal"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ23_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1 = Mild slowing and/or reduction"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ23_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2 = Moderately impaired, early fatiguing"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ23_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3 = Severely impaired, frequent arrests"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ23_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4 = Can barely perform the task"
                    android:textColor="#333333" />
            </RadioGroup>
        </LinearLayout>

        <!-- 24. Hand Movements -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/edit_text_border"
            android:backgroundTint="#F0F5F2"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="24. Hand Movements (Open and Close Hands)"
                android:textColor="#315C55"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgQ24"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/rbQ24_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="0 = Normal"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ24_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1 = Mild slowing and/or reduction"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ24_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2 = Moderately impaired, early fatiguing"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ24_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3 = Severely impaired, frequent arrests"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ24_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4 = Can barely perform the task"
                    android:textColor="#333333" />
            </RadioGroup>
        </LinearLayout>

        <!-- 25. Rapid Alternating Movements -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/edit_text_border"
            android:backgroundTint="#F0F5F2"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="25. Rapid Alternating Movements of Hands"
                android:textColor="#315C55"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgQ25"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/rbQ25_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="0 = Normal"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ25_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1 = Mild slowing and/or reduction"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ25_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2 = Moderately impaired, early fatiguing"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ25_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3 = Severely impaired, frequent arrests"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ25_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4 = Can barely perform the task"
                    android:textColor="#333333" />
            </RadioGroup>
        </LinearLayout>

        <!-- 26. Leg Agility -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/edit_text_border"
            android:backgroundTint="#F0F5F2"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="26. Leg Agility (Tap Heel on Ground)"
                android:textColor="#315C55"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgQ26"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/rbQ26_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="0 = Normal"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ26_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1 = Mild slowing and/or reduction"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ26_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2 = Moderately impaired, early fatiguing"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ26_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3 = Severely impaired, frequent arrests"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ26_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4 = Can barely perform the task"
                    android:textColor="#333333" />
            </RadioGroup>
        </LinearLayout>

        <!-- 27. Arising from Chair -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/edit_text_border"
            android:backgroundTint="#F0F5F2"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="27. Arising from Chair"
                android:textColor="#315C55"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgQ27"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/rbQ27_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="0 = Normal"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ27_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1 = Slow, or may need more than 1 attempt"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ27_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2 = Pushes self up from arms of seat"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ27_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3 = Tends to fall back, several attempts"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ27_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4 = Unable to arise without help"
                    android:textColor="#333333" />
            </RadioGroup>
        </LinearLayout>

        <!-- 28. Posture -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/edit_text_border"
            android:backgroundTint="#F0F5F2"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="28. Posture"
                android:textColor="#315C55"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgQ28"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/rbQ28_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="0 = Normal erect"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ28_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1 = Slightly stooped posture"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ28_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2 = Moderately stooped posture"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ28_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3 = Severely stooped posture with kyphosis"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ28_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4 = Marked flexion with extreme posture abnormality"
                    android:textColor="#333333" />
            </RadioGroup>
        </LinearLayout>

        <!-- 29. Gait -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/edit_text_border"
            android:backgroundTint="#F0F5F2"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="29. Gait &amp; Walking"
                android:textColor="#315C55"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgQ29"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/rbQ29_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="0 = Normal"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ29_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1 = Walks slowly, may shuffle with short steps"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ29_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2 = Walks with difficulty, little/no assistance"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ29_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3 = Severe gait disturbance, requires assistance"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ29_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4 = Cannot walk at all, even with assistance"
                    android:textColor="#333333" />
            </RadioGroup>
        </LinearLayout>

        <!-- 30. Postural Stability -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/edit_text_border"
            android:backgroundTint="#F0F5F2"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="30. Postural Stability"
                android:textColor="#315C55"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgQ30"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/rbQ30_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="0 = Normal"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ30_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1 = Retropulsion, but recovers unaided"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ30_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2 = Absence of postural response; would fall"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ30_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3 = Very unstable, loses balance spontaneously"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ30_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4 = Unable to stand without assistance"
                    android:textColor="#333333" />
            </RadioGroup>
        </LinearLayout>

        <!-- 31. Body Bradykinesia and Hypokinesia -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/edit_text_border"
            android:backgroundTint="#F0F5F2"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="31. Body Bradykinesia and Hypokinesia"
                android:textColor="#315C55"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgQ31"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/rbQ31_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="0 = None"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ31_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1 = Minimal slowness, deliberate character"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ31_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2 = Mild degree of slowness / poverty of movement"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ31_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3 = Moderate slowness, poverty or small amplitude"
                    android:textColor="#333333" />

                <RadioButton
                    android:id="@+id/rbQ31_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4 = Marked slowness, poverty or small amplitude"
                    android:textColor="#333333" />
            </RadioGroup>
        </LinearLayout>

        <!-- Finish button -->
        <Button
            android:id="@+id/btnFinish"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#477D70"
            android:text="Finish the test to see the score"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

    </LinearLayout>

</ScrollView>