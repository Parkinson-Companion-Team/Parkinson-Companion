<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5F0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="36dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Top Header Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="70dp"
                android:layout_height="48dp"
                android:backgroundTint="#315C55"
                android:contentDescription="Go back"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="4dp"
                android:text="←"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Diet &amp; Calorie Tracker"
                android:textColor="#315C55"
                android:textSize="21sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Title & Subtitle from Design -->
        <TextView
            android:id="@+id/tvWelcomeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal"
            android:text="Welcome to Diet &amp; Calorie Tracker"
            android:textColor="#244C43"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWelcomeSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:gravity="center_horizontal"
            android:text="Tell us a little about yourself so we can estimate the daily nutritional needs."
            android:textColor="#606B66"
            android:textSize="15sp" />

        <!-- Card Container for Form Fields -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Age Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Age"
                android:textColor="#244C43"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAge"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/edit_text_border"
                android:hint="Enter your age in years"
                android:inputType="number"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#244C43"
                android:textColorHint="#8A9691"
                android:textSize="15sp" />

            <!-- Sex Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Sex"
                android:textColor="#244C43"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerSex"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/edit_text_border"
                android:minHeight="48dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <!-- Height Field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Height"
                    android:textColor="#244C43"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unit: "
                    android:textColor="#606B66"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spinnerHeightUnit"
                    android:layout_width="110dp"
                    android:layout_height="36dp"
                    android:background="@drawable/edit_text_border" />
            </LinearLayout>

            <!-- Height Input Fields -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <!-- CM Input -->
                <EditText
                    android:id="@+id/etHeightCm"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/edit_text_border"
                    android:hint="Enter your height in cm"
                    android:inputType="numberDecimal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#244C43"
                    android:textColorHint="#8A9691"
                    android:textSize="15sp"
                    android:visibility="visible" />

                <!-- Ft & In Input -->
                <LinearLayout
                    android:id="@+id/layoutHeightFtIn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etHeightFt"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/edit_text_border"
                        android:hint="Feet (ft)"
                        android:inputType="number"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="#244C43"
                        android:textColorHint="#8A9691"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/etHeightIn"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/edit_text_border"
                        android:hint="Inches (in)"
                        android:inputType="numberDecimal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="#244C43"
                        android:textColorHint="#8A9691"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Inches Input -->
                <EditText
                    android:id="@+id/etHeightInches"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/edit_text_border"
                    android:hint="Enter your height in inches"
                    android:inputType="numberDecimal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#244C43"
                    android:textColorHint="#8A9691"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <!-- Meters Input -->
                <EditText
                    android:id="@+id/etHeightMeters"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/edit_text_border"
                    android:hint="Enter your height in meters"
                    android:inputType="numberDecimal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#244C43"
                    android:textColorHint="#8A9691"
                    android:textSize="15sp"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- Conversion option to cm display & button -->
            <LinearLayout
                android:id="@+id/layoutHeightConversion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvHeightConverted"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Converted: 0.0 cm"
                    android:textColor="#315C55"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnConvertHeight"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="#477D70"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Convert to cm"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Weight Field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Weight"
                    android:textColor="#244C43"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unit: "
                    android:textColor="#606B66"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spinnerWeightUnit"
                    android:layout_width="110dp"
                    android:layout_height="36dp"
                    android:background="@drawable/edit_text_border" />
            </LinearLayout>

            <!-- Weight Input Fields -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <!-- KG Input -->
                <EditText
                    android:id="@+id/etWeightKg"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/edit_text_border"
                    android:hint="Enter your weight in kg"
                    android:inputType="numberDecimal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#244C43"
                    android:textColorHint="#8A9691"
                    android:textSize="15sp"
                    android:visibility="visible" />

                <!-- LBS Input -->
                <EditText
                    android:id="@+id/etWeightLbs"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/edit_text_border"
                    android:hint="Enter your weight in lbs"
                    android:inputType="numberDecimal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#244C43"
                    android:textColorHint="#8A9691"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <!-- ST (Stones) Input -->
                <EditText
                    android:id="@+id/etWeightSt"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/edit_text_border"
                    android:hint="Enter your weight in stones (st)"
                    android:inputType="numberDecimal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#244C43"
                    android:textColorHint="#8A9691"
                    android:textSize="15sp"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- Conversion option to kg display & button -->
            <LinearLayout
                android:id="@+id/layoutWeightConversion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvWeightConverted"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Converted: 0.0 kg"
                    android:textColor="#315C55"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnConvertWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="#477D70"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Convert to kg"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Activity Level Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Activity level"
                android:textColor="#244C43"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerActivityLevel"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/edit_text_border"
                android:minHeight="48dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <!-- Calculate Button -->
            <Button
                android:id="@+id/btnCalculate"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#315C55"
                android:text="Estimate Daily Nutritional Needs"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Results Card -->
        <LinearLayout
            android:id="@+id/cardResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#DDECE5"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🥗 Estimated Daily Nutritional Needs"
                android:textColor="#244C43"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCalories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#1B3831"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvProtein"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#244C43"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvCarbs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#244C43"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvFats"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#244C43"
                    android:textSize="14sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvWater"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#244C43"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="#B2C2BC" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 Parkinson's Dietary Guidelines:"
                android:textColor="#244C43"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="• Separate high-protein meals from levodopa medication times (at least 30-60 mins apart).\n• Ensure adequate dietary fiber (whole grains, fruits, vegetables) for healthy digestion.\n• Stay hydrated with 2+ Liters of water daily.\n• Focus on antioxidant-rich foods (berries, leafy greens, nuts)."
                android:textColor="#3A5E55"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>